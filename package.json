{
  "name": "@udondan/marktguru-cli",
  "version": "1.0.6",
  "description": "CLI for Marktguru supermarket deals in Austria and Germany",
  "license": "MIT",
  "author": {
    "name": "Daniel Schroeder",
    "url": "https://www.udondan.com/"
  },
  "contributors": [
    "Manuel Maly"
  ],
  "homepage": "https://github.com/udondan/marktguru-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/udondan/marktguru-cli.git"
  },
  "bugs": {
    "url": "https://github.com/udondan/marktguru-cli/issues"
  },
  "keywords": [
    "cli",
    "marktguru",
    "grocery",
    "deals",
    "discounts",
    "austria",
    "germany"
  ],
  "type": "module",
  "bin": {
    "marktguru": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun src/cli.ts",
    "start": "node dist/cli.js",
    "test": "bun run build && tsc -p tsconfig-tests.json && c8 node --test tests/*.test.ts",
    "test:unit": "bun run build && tsc -p tsconfig-tests.json && c8 node --test --test-skip-pattern=\"^live:\" tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "c8": "12.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "14.0.6"
  }
}
